# API do catálogo Milagros
API_URL=https://catalogo-milagros.betaup.com.br

# Credenciais de serviço usadas por POST /api/auth/login.
# Server-only: nunca prefixar com NEXT_PUBLIC_ — isso vazaria o segredo no
# bundle do client. O token e a tabela de preço vêm da resposta do login.
CATALOG_API_USER=
CATALOG_API_PASSWORD=
